{
  "version": 1,
  "note": "典型工作流模板（第一批 10 条）。steps 顺序即连线顺序（相邻步骤连线）。所有模板仅基于工具公开能力与任务逻辑编排：verified 一律为 false，接口兼容性未经端到端实测；needsManual/needsConfig 为依据工具公开资料的判断，载入模板后仍需经连线检查器逐条复核。",
  "templates": [
    {
      "id": "tpl-web-content",
      "title": "网页内容处理",
      "steps": [
        {
          "tool": "firecrawl/firecrawl-mcp-server",
          "desc": "抓取网页，输出适合 LLM 的内容",
          "input": "网页 URL",
          "output": "Markdown / 文本",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "需要 Firecrawl API Key",
          "verified": false,
          "verifyNote": "未做端到端实测"
        },
        {
          "tool": "zcaceres/markdownify-mcp",
          "desc": "把抓取结果统一转成 Markdown",
          "input": "HTML / 文本",
          "output": "Markdown",
          "needsManual": false,
          "needsConfig": false,
          "configNote": "",
          "verified": false,
          "verifyNote": "未做端到端实测；格式衔接需人工确认"
        },
        {
          "tool": "Unstructured-IO/UNS-MCP",
          "desc": "文档解析与结构化",
          "input": "文档（PDF/HTML/文本）",
          "output": "结构化 JSON",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "Unstructured 部分能力需要 API Key 或本地部署",
          "verified": false,
          "verifyNote": "未做端到端实测"
        }
      ]
    },
    {
      "id": "tpl-code-quality",
      "title": "代码质量分析",
      "steps": [
        {
          "tool": "github/github-mcp-server",
          "desc": "读取 GitHub 仓库代码与文件",
          "input": "仓库 / 文件路径",
          "output": "代码 / 文件内容",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "需要 GitHub Token 与 MCP 客户端配置",
          "verified": false,
          "verifyNote": "未做端到端实测"
        },
        {
          "tool": "SonarSource/sonarqube-mcp-server",
          "desc": "代码质量与安全检查",
          "input": "代码 / 仓库",
          "output": "质量报告 JSON",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "需要 SonarQube 服务端与项目 Key",
          "verified": false,
          "verifyNote": "未做端到端实测"
        },
        {
          "tool": "yuque/yuque-mcp-server",
          "desc": "把分析结果整理进知识库",
          "input": "文本 / 报告",
          "output": "语雀文档",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "需要语雀 Token",
          "verified": false,
          "verifyNote": "未做端到端实测"
        }
      ]
    },
    {
      "id": "tpl-data-analysis",
      "title": "数据分析",
      "steps": [
        {
          "tool": "ClickHouse/mcp-clickhouse",
          "desc": "查询分析数据库",
          "input": "SQL 查询",
          "output": "查询结果 JSON",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "需要 ClickHouse 连接串与凭据",
          "verified": false,
          "verifyNote": "未做端到端实测"
        },
        {
          "tool": "datalayer/jupyter-mcp-server",
          "desc": "在 Jupyter Notebook 中做数据分析",
          "input": "数据 / 代码",
          "output": "Notebook 结果",
          "needsManual": true,
          "needsConfig": true,
          "configNote": "需要可运行的 Jupyter 内核，Notebook 执行可能需人工确认",
          "verified": false,
          "verifyNote": "未做端到端实测"
        },
        {
          "tool": "hustcc/mcp-echarts",
          "desc": "生成 ECharts 图表",
          "input": "JSON 数据",
          "output": "图表（HTML/图片）",
          "needsManual": false,
          "needsConfig": false,
          "configNote": "",
          "verified": false,
          "verifyNote": "未做端到端实测；数据格式衔接需确认"
        }
      ]
    },
    {
      "id": "tpl-container-ops",
      "title": "容器运维",
      "steps": [
        {
          "tool": "docker/hub-mcp",
          "desc": "Docker 镜像查询与管理",
          "input": "镜像名 / 查询",
          "output": "镜像信息 JSON",
          "needsManual": false,
