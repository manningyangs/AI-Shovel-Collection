        {
          "tool": "reza-gholizade/k8s-mcp-server",
          "desc": "Kubernetes 集群部署与运维",
          "input": "K8s 操作指令 / YAML",
          "output": "集群状态 JSON",
          "needsManual": true,
          "needsConfig": true,
          "configNote": "需要 kubeconfig 与集群权限；部署动作建议人工确认",
          "verified": false,
          "verifyNote": "未做端到端实测"
        },
        {
          "tool": "grafana/mcp-grafana",
          "desc": "为部署的服务建立监控面板",
          "input": "指标 / 数据源",
          "output": "监控面板与告警",
          "needsManual": false,
          "needsConfig": true,
          "configNote": "需要 Grafana 地址与 API Token",
          "verified": false,
          "verifyNote": "未做端到端实测"
        }
      ]
    },
    {
      "id": "tpl-monitor-alert",
      "title": "监控分析",
      "steps": [
        {
          "tool": "grafana/mcp-grafana",
