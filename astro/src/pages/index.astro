</div>

<header class="hero" id="hero">
  <div class="hero-inner hero-v21">
    <h1>发现让 AI 真正<span class="grad">动手干活</span>的铲子</h1>
    <p class="sub">社区精选 + Pipeline 自动发现 · 端点实测验证 · 每 6 小时同步</p>
  </div>
  <div class="hero-search">
    <div class="search-box" id="searchBox">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"></path></svg>
      <input type="text" id="searchInput" placeholder="你想让 AI 做什么？搜索工具或具体任务……" autocomplete="off" spellcheck="false" aria-label="搜索已收录的工具" aria-describedby="count">
      <span class="count" id="count" aria-live="polite" role="status"></span>
      <button class="clear-btn" id="clearBtn" title="清空" aria-label="清空搜索框">&times;</button>
    </div>
    <div class="search-examples">
      <span class="se-label">试试：</span>
      <button class="se-chip" type="button" data-pre="3." data-q="PPT">自动制作 PPT</button>
      <button class="se-chip" type="button" data-pre="3." data-q="Excel">分析 Excel</button>
      <button class="se-chip" type="button" data-pre="11." data-q="CAD">画 CAD / 3D</button>
      <button class="se-chip" type="button" data-pre="6." data-q="Docker">部署 Docker</button>
      <button class="se-chip" type="button" data-pre="2." data-q="浏览器">浏览器自动化</button>
      <button class="se-chip" type="button" data-pre="9A." data-q="飞书">接飞书 / 钉钉</button>
    </div>
  </div>

  <!-- V2.1: 任务入口 10 个全可见（去掉更多按钮） -->
  <div class="task-bar task-v21" id="taskBar">
    <div class="task-inner">
      <div class="task-chips" id="taskChips" role="group" aria-label="按任务筛选工具">
        <button class="task-chip" data-pre="3." type="button"><span class="tc-icon">📝</span><span class="tc-text">写文档 / 做 PPT</span></button>
        <button class="task-chip" data-pre="2." type="button"><span class="tc-icon">🌐</span><span class="tc-text">浏览器自动化</span></button>
        <button class="task-chip" data-pre="6." type="button"><span class="tc-icon">🚀</span><span class="tc-text">部署运维</span></button>
        <button class="task-chip" data-pre="11." type="button"><span class="tc-icon">🗺️</span><span class="tc-text">CAD · 3D · 地图</span></button>
        <button class="task-chip" data-pre="9A." type="button"><span class="tc-icon">💬</span><span class="tc-text">飞书 · 钉钉 · 微信</span></button>
        <button class="task-chip" data-pre="5." type="button"><span class="tc-icon">📊</span><span class="tc-text">查数据库 · 数据分析</span></button>
        <button class="task-chip" data-pre="10." type="button"><span class="tc-icon">🎨</span><span class="tc-text">图片 · 视频 · 音频</span></button>
        <button class="task-chip" data-pre="8." type="button"><span class="tc-icon">💰</span><span class="tc-text">财务 · 会计</span></button>
        <button class="task-chip" data-pre="13." type="button"><span class="tc-icon">🤖</span><span class="tc-text">机器人 · IoT · 硬件</span></button>
        <button class="task-chip" data-pre="7." type="button"><span class="tc-icon">📧</span><span class="tc-text">邮件 · 日历 · 协作</span></button>
      </div>
    </div>
  </div>

  <!-- V2.1: 统计 4 个（上移到排行榜上方；恢复初始值 + data-target 给 animateStats 动画） -->
  <div class="stats-grid stats-v21" id="statsGrid" role="region" aria-label="核心数据统计">
    <div class="stat-card" title="catalog.csv 中的人工精选行数"><div class="stat-num c1" id="statCurated" data-target={catalogItems.length}>{catalogItems.length}</div><div class="stat-label">精选工具</div></div>
    <div class="stat-card" title="Pipeline 自动发现的候选条目"><div class="stat-num c3" id="statCand" data-target="0">…</div><div class="stat-label">发现候选</div></div>
    <div class="stat-card" title="MCP initialize 握手实测通过的端点数"><div class="stat-num c1" id="statVfy">—</div><div class="stat-label">端点实测 OK</div></div>
    <div class="stat-card" title="已收录仓库的 GitHub Stars 累加"><div class="stat-num c4" id="statStars">…</div><div class="stat-label">累计 GitHub Stars</div></div>
  </div>

  <!-- V2.1: Trending Top 3 横排区块 -->
  {trendingTop3.length > 0 ? (
  <section class="trending-top-v21" aria-label="🔥 Trending Top 3">
    <div class="ttv21-head">
      <span class="ttv21-badge">🔥 LIVE</span>
      <span class="ttv21-title">本周 Stars 冠军</span>
      <a href="/AI-Shovel-Collection/trending/" class="ttv21-all">完整榜单 →</a>
    </div>
    <div class="ttv21-row">
      {trendingTop3.map((t, i) => (
        <a href={detailHref(t.slug)} class="ttv21-card" style={i === 0 ? '--ttv21-rank:#f59e0b' : i === 1 ? '--ttv21-rank:#94a3b8' : '--ttv21-rank:#d97706'}>
          <span class="ttv21-rank">#{i + 1}</span>
          <span class="ttv21-name">{esc(t.name)}</span>
          <span class="ttv21-meta">
            <span class="ttv21-stars">⭐ {fmtStars(t.live.stars)}</span>
            {t.live.lang ? <span class="ttv21-lang">{esc(t.live.lang)}</span> : null}
          </span>
        </a>
      ))}
    </div>
  </section>
  ) : null}

  <!-- 最新评测报告预览（原统计卡片位置：排行榜下方、工具卡片区域之前） -->
  <EvaluationFeatured />

  <noscript><div class="noscript-note">⚠️ 当前浏览器未启用 JavaScript：下方列表需 JS 渲染，请直接查看 <a href="https://github.com/manningyangs/AI-Shovel-Collection/blob/main/catalog.csv">catalog.csv</a>（191 条精选）或 <a href="live_multi.json">live_multi.json</a>（含候选与端点实测数据）。</div></noscript>
</header>

<!-- AI 工具生态地图预览（评测报告下方、工具分类上方） -->
<ToolMapPreview
  client:visible
  stats={mapPreview.stats}
  capabilityCount={mapPreview.capabilityCount}
  nodes={mapPreview.nodes}
  edges={mapPreview.edges}
  baseUrl={mapPreview.baseUrl}
/>

<div class="toolbar">
  <div class="toolbar-inner">
    <div class="meta-row">
      <div class="meta-filters" id="metaFilters" role="group" aria-label="按元数据进一步筛选">
        <label class="mf-item">
          <span class="mf-label">语言</span>
          <select id="fLang" aria-label="按编程语言筛选"><option value="">全部</option></select>
        </label>
        <label class="mf-item">
          <span class="mf-label">Stars</span>
          <select id="fStars" aria-label="按 GitHub Stars 数量筛选">
            <option value="0">不限</option><option value="100">≥ 100</option><option value="500">≥ 500</option>
            <option value="1000">≥ 1k</option><option value="5000">≥ 5k</option><option value="10000">≥ 10k</option>
          </select>
        </label>
        <label class="mf-item">
          <span class="mf-label">更新</span>
          <select id="fFresh" aria-label="按最近更新时间筛选">
            <option value="0">不限</option><option value="1">24 小时内</option><option value="7">7 天内</option>
            <option value="30">30 天内</option><option value="180">半年内</option>
          </select>
        </label>
        <button class="mf-reset" id="fReset" type="button" aria-label="清空全部筛选条件">↺ 重置</button>
        <span class="mf-hint">组合筛选只作用于「已收录」列表</span>
      </div>
      <button class="chip chip-toggle" id="btnToggleChips" title="手动展开/收起分类筛选" aria-expanded="true" aria-controls="chips" type="button"></button>
    </div>
    <div class="chips" id="chips"></div>
  </div>
</div>

<main>
  <div class="list-tabs" id="listTabs" role="tablist">
    <button class="list-tab active" data-tab="curated" type="button" role="tab" aria-selected="true">📦 精选工具<span class="tab-count" id="tabCuratedCount">191</span></button>
    <button class="list-tab" data-tab="candidates" type="button" role="tab" aria-selected="false">🧭 自动发现<span class="tab-count" id="tabCandidateCount">150</span></button>
    <button class="list-tab" data-tab="live" type="button" role="tab" aria-selected="false">🌐 GitHub 实时搜索</button>
  </div>
  <div class="sort-bar" id="sortBar">
    <span class="mf-label">排序：</span>
    <select id="sortSelect" aria-label="排序方式">
      <option value="default">综合推荐</option><option value="stars">Stars 最高</option>
      <option value="recent">最近更新</option><option value="verified">已核验优先</option>
    </select>
  </div>
  <section id="tools" data-tabpanel="curated">
    <div class="section-head">
      <h2>📦 已收录的铲子<span class="unverified-tag" style="background:#eef2ff;color:#3730a3" title="人工筛选入库：仓库存在、用途明确、分类经人工确认；尚未逐项功能实测">👤 人工筛选</span></h2>
      <span class="hint">分类不是质量排名，收录不代表背书 · <b>已收录 = 人工筛选入库</b>（未逐项功能实测）</span>
      <span class="live-updated" id="liveUpdated" title="仓库 stars / 更新时间由 GitHub Actions 每 6 小时同步">实时数据同步中…</span>
    </div>
    <div class="grid" id="grid" data-pre="1">
      {catalogItems.map(it => {
        const live = liveBySlug[it.slug] || {};
        const desc = live.desc || '';
        const stars = live.stars || 0;
        const lang = live.lang || '';
        const endpoint = live.endpoint || '';
        const epSt = live.endpoint_status || '';
        return (
          <article class="card" data-slug={it.slug}>
            <div class="card-top">
              <div class="card-title"><a href={detailHref(it.slug)}>{esc(it.name)}</a></div>
              <span class="badge" style={colorStyle(it.cat)} title={esc(it.cat)}>{esc(it.catLabel)}</span>
            </div>
            {desc ? <div class="card-desc">{esc(desc.slice(0, 180))}</div> : null}
            {endpoint ? <span class="ep-pill" style={epSt === 'ok' ? 'background:#ecfdf5;color:#059669;border:1px solid #6ee7b7' : epSt === 'fail' ? 'background:#fef2f2;color:#dc2626;border:1px solid #fca5a5' : epSt === 'auth' ? 'background:#fffbeb;color:#d97706;border:1px solid #fcd34d' : ''} title={esc(endpoint + (epSt ? ' — ' + epSt : ''))}>🔗</span> : null}
            <div class="card-live">
              {stars ? <span class="badge" style="--badge-bg:#fffbeb;--badge-fg:#b45309;--badge-bd:#fde68a">⭐ {fmtStars(stars)}</span> : null}
              {lang ? <span class="lang-pill">{esc(lang)}</span> : null}
              {live.source && live.source !== 'github_rest' ? <span class="badge" style="--badge-bg:#f0fdf4;--badge-fg:#059669;--badge-bd:#86efac">{esc(live.source)}</span> : null}
              {live.pushed_at ? <span class="fresh" data-pushed={live.pushed_at}></span> : null}
            </div>
            <div class="card-foot">
              <span class="card-repo">{esc(it.slug)}</span>
              <span>
                <a class="ext" href={it.url} target="_blank" rel="noopener">GitHub ↗</a>
                <a class="ext" href={detailHref(it.slug)}>详情</a>
              </span>
            </div>
          </article>
        );
      })}
    </div>
    <div class="empty" id="empty"></div>
  </section>
  <section id="candidates" class="candidates-section" data-tabpanel="candidates" style="display:none">
    <div class="section-head">
      <h2>🧭 自动发现的候选铲子<span class="unverified-tag" title="机器检索入库：分类与可用性未经人工核验。confidence 是自动匹配分（算法推断可信度），不是工具质量评分">🤖 自动发现</span></h2>
      <span class="hint">由 Pipeline 从 MCP Registry / npm / crates.io 挖到，<b>未人工核验</b> · ✅ 端点实测仅代表 MCP 握手在线，<b>不代表功能完整可用</b></span>
    </div>
    <div class="candidates-hint">候选按 <b>MCP 官方注册 + Stars / 下载量 + 端点可调用 + 活跃状态</b> 加权排序 · 当前每轮保留 Top <b id="candidateCount">…</b> 条</div>
    <div id="inboxBanner" class="inbox-banner"></div>
    <div class="grid" id="candidateGrid"></div>
  </section>
  <section id="liveTab" data-tabpanel="live" style="display:none">
    <div class="section-head">
      <h2>🌐 GitHub 全站实时搜索</h2>
      <span class="hint">由 GitHub Search API 实时返回，按 Stars 排序，已收录的仓库自动去重</span>
    </div>
    <div class="live-search-strip show" id="liveStrip">
      <span class="txt" id="liveStripText">点击下方按钮在 GitHub 全站几十亿级仓库中搜索</span>
      <button class="btn-live" id="btnLive">🌐 立即实时搜索 GitHub 全站</button>
      <span class="live-status" id="liveStatus"></span>
    </div>
    <div class="grid" id="liveGrid2"></div>
  </section>
</main>

