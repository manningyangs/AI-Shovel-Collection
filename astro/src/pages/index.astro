---
import Base from '../layouts/Base.astro';
import EvaluationFeatured from '../components/EvaluationFeatured.astro';
import ToolMapPreview from '../components/ToolMap/ToolMapPreview.tsx';
import '../styles/main.css';
import fs from 'fs';
import path from 'path';
// Use process.cwd() which is project root (repo/astro/) during astro build
const appJs = fs.readFileSync(path.resolve(process.cwd(), 'src/scripts/app.js'), 'utf8');

// Astro SSG: 构建时读取 catalog.csv + live_multi.json，预渲染 curated 卡片到 HTML
const csvMod = import.meta.glob('../../public/catalog.csv', { as: 'raw', eager: true });
const liveMod = import.meta.glob('../../public/live_multi.json', { as: 'json', eager: true });
const csvRaw = csvMod['../../public/catalog.csv'] || '';
const liveData = liveMod['../../public/live_multi.json'] || { curated: {} };

// 解析 catalog.csv → [{ cat, name, url, slug, catLabel }]
function parseCatalog(raw) {
  const rows = raw.replace(/^\uFEFF/, '').split(/\r?\n/).filter(l => l.trim() && !l.startsWith('分类'));
  return rows.map(row => {
    const parts = row.split(',');
    const cat = (parts[0] || '').trim();
    const full = (parts[1] || '').trim();
    const url = (parts[2] || '').trim();
    const name = full.replace(/^\d+[A-Za-z]?\.\s*/, '');
    const slug = url.replace(/^https?:\/\/(www\.)?github\.com\//, '').replace(/\.git$/, '').replace(/\/$/, '');
    const catLabel = cat.replace(/^\d+[A-Za-z]?\.\s*/, '');
    return { cat, catLabel, name, url, slug };
  });
}

// curated: object → array
const curatedArr = Array.isArray(liveData.curated) ? liveData.curated : Object.values(liveData.curated || {});
const liveBySlug = {};
curatedArr.forEach(c => { const s = (c.repo_url || '').replace(/^https?:\/\/(www\.)?github\.com\//, '').replace(/\.git$/, ''); if (s) liveBySlug[s] = c; });

// 社区提交候选池（public/submissions/candidates.json，由 collection-submission 工作流维护）
// 与 /submit/ 收录列表、工具目录「提交收录」Tab 共用同一数据源；与自动发现候选池完全独立
const poolMod = import.meta.glob('../../public/submissions/candidates.json', { as: 'json', eager: true });
const poolData = poolMod['../../public/submissions/candidates.json'] || null;
const poolArr = poolData
  ? (Array.isArray(poolData) ? poolData : (Array.isArray(poolData.candidates) ? poolData.candidates : []))
  : [];
const communityPool = {
  total: poolData && typeof poolData.total === 'number' ? poolData.total : poolArr.length,
  pending: poolArr.filter(c => (c.review_status || 'pending') === 'pending').length,
  approved: poolArr.filter(c => c.review_status === 'approved').length,
  recent: poolArr
    .slice()
    .sort((a, b) => (b.submitted_at || 0) - (a.submitted_at || 0))
    .slice(0, 4),
};

const catalogItems = parseCatalog(csvRaw);
const colorPalette = ['#eef2ff', '#c7d2fe', '#4f46e5', '#fef3c7', '#fbbf24', '#f59e0b', '#fef9c3', '#f0fdf4', '#22c55e', '#86efac', '#fce7f3', '#f9a8d4'];
const colorOf = {};
const seenCats = {};
catalogItems.forEach(it => {
  if (!seenCats[it.cat]) { seenCats[it.cat] = Object.keys(seenCats).length; }
  colorOf[it.cat] = colorPalette[seenCats[it.cat] % colorPalette.length];
});
function colorStyle(cat) {
  const bg = colorOf[cat] || '#eef2ff';
  return `--badge-bg:${bg};--badge-fg:#3730a3;--badge-bd:${bg}`;
}

function esc(s) { return String(s || '').replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c])); }
function detailHref(s) { return `/AI-Shovel-Collection/tools/${(s || '').replace(/\//g, '-')}/`; }
function fmtStars(n) { return (n == null || n === '' ? '' : Number(n).toLocaleString()); }
function starsStyle(n) { return n > 10000 ? 'color:#dc2626' : n > 1000 ? 'color:#ea580c' : ''; }

// V2.1: Trending Top 3（按 Stars 排序，实时）
const withStars = catalogItems
  .map(it => ({ ...it, live: liveBySlug[it.slug] || {} }))
  .filter(it => it.live.stars > 0)
  .sort((a, b) => (b.live.stars || 0) - (a.live.stars || 0));
const trendingTop3 = withStars.slice(0, 3);

// V2.1: Domains 简洁入口（取前 8 条）
const domainMod = import.meta.glob('../../public/README.md', { as: 'raw', eager: true });
const readmeRaw = domainMod['../../public/README.md'] || '';
const domainRows = (() => {
  if (!readmeRaw) return [];
  const lines = readmeRaw.split(/\r?\n/);
  let inSection = false, rows = [];
  for (const line of lines) {
    if (line.indexOf('## ') === 0) { inSection = line.indexOf('按行业/领域检索') !== -1; continue; }
    if (!inSection) continue;
    if (line.indexOf('|') !== 0) { if (rows.length && line.trim() === '') break; continue; }
    const cells = line.split('|');
    if (cells.length < 4) continue;
    const name = cells[1].trim();
    if (!name || name === '领域' || /^-+$/.test(name)) continue;
    const linksCell = cells[2];
    const firstLink = (linksCell.match(/\[([^\]]+)\]\(([^)]+)\)/) || [])[2];
    rows.push({ name, url: firstLink || '#' });
  }
  return rows;
})();
const domainsTop8 = domainRows.slice(0, 8);
const domainsTotal = domainRows.length;

// AI Tool Map 预览数据（构建期读取生成产物；缺失时组件降级为占位+入口）
let mapPreview = null;
try {
  const mapRaw = fs.readFileSync(path.resolve(process.cwd(), 'public/data/tool-map.json'), 'utf8');
  const mapData = JSON.parse(mapRaw);
  const REL_ORDER = ['integration', 'protocol', 'complementary', 'alternative'];
  const capIdx = {};
  (mapData.capabilities || []).forEach((c, i) => { capIdx[c.id] = i; });
  const idIdx = {};
  const previewNodes = (mapData.nodes || []).map((n, i) => {
    idIdx[n.id] = i;
    return [n.position.x, n.position.y, capIdx[n.capability] ?? 0];
  });
  const previewEdges = (mapData.relations || [])
    .map(r => [idIdx[r.source], idIdx[r.target], REL_ORDER.indexOf(r.type)])
    .filter(e => e[0] != null && e[1] != null && e[2] >= 0);
  mapPreview = {
    stats: { mapNodes: mapData.stats?.mapNodes, relationTotal: mapData.stats?.relationTotal },
    capabilityCount: (mapData.capabilities || []).length,
    nodes: previewNodes,
    edges: previewEdges,
    baseUrl: '/AI-Shovel-Collection',
  };
} catch (e) {
  // tool-map.json 尚未生成 → 预览组件走占位态（仅 CTA）
  mapPreview = { baseUrl: '/AI-Shovel-Collection' };
}
---

