<header class="hero" id="hero">
  <div class="hero-inner hero-v21">
    <h1>发现让 AI 真正<span class="grad">动手干活</span>的铲子</h1>
    <p class="sub">社区精选 + Pipeline 自动发现 · 端点实测验证 · 每 6 小时同步</p>
  </div>
  <div class="hero-search">
    <div class="search-box" id="searchBox">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"></path></svg>
      <input type="text" id="searchInput" placeholder="你想让 AI 做什么？搜索工具或具体任务……" autocomplete="off" spellcheck="false" aria-label="搜索已收录的工具" aria-describedby="count">
      <span class="count" id="count" aria-live="polite" role="status"></span>
      <button class="clear-btn" id="clearBtn" title="清空" aria-label="清空搜索框">&times;</button>
    </div>
    <div class="search-examples">
      <span class="se-label">试试：</span>
      <button class="se-chip" type="button" data-pre="3." data-q="PPT">自动制作 PPT</button>
      <button class="se-chip" type="button" data-pre="3." data-q="Excel">分析 Excel</button>
      <button class="se-chip" type="button" data-pre="11." data-q="CAD">画 CAD / 3D</button>
      <button class="se-chip" type="button" data-pre="6." data-q="Docker">部署 Docker</button>
      <button class="se-chip" type="button" data-pre="2." data-q="浏览器">浏览器自动化</button>
      <button class="se-chip" type="button" data-pre="9A." data-q="飞书">接飞书 / 钉钉</button>
    </div>
  </div>

  <!-- V2.1: 任务入口 10 个全可见（去掉更多按钮） -->
  <div class="task-bar task-v21" id="taskBar">
    <div class="task-inner">
      <div class="task-chips" id="taskChips" role="group" aria-label="按任务筛选工具">
        <button class="task-chip" data-pre="3." type="button"><span class="tc-icon">📝</span><span class="tc-text">写文档 / 做 PPT</span></button>
        <button class="task-chip" data-pre="2." type="button"><span class="tc-icon">🌐</span><span class="tc-text">浏览器自动化</span></button>
        <button class="task-chip" data-pre="6." type="button"><span class="tc-icon">🚀</span><span class="tc-text">部署运维</span></button>
        <button class="task-chip" data-pre="11." type="button"><span class="tc-icon">🗺️</span><span class="tc-text">CAD · 3D · 地图</span></button>
        <button class="task-chip" data-pre="9A." type="button"><span class="tc-icon">💬</span><span class="tc-text">飞书 · 钉钉 · 微信</span></button>
        <button class="task-chip" data-pre="5." type="button"><span class="tc-icon">📊</span><span class="tc-text">查数据库 · 数据分析</span></button>
        <button class="task-chip" data-pre="10." type="button"><span class="tc-icon">🎨</span><span class="tc-text">图片 · 视频 · 音频</span></button>
        <button class="task-chip" data-pre="8." type="button"><span class="tc-icon">💰</span><span class="tc-text">财务 · 会计</span></button>
        <button class="task-chip" data-pre="13." type="button"><span class="tc-icon">🤖</span><span class="tc-text">机器人 · IoT · 硬件</span></button>
        <button class="task-chip" data-pre="7." type="button"><span class="tc-icon">📧</span><span class="tc-text">邮件 · 日历 · 协作</span></button>
      </div>
    </div>
  </div>

  <!-- V2.1: 统计 4 个（上移到排行榜上方；恢复初始值 + data-target 给 animateStats 动画） -->
  <div class="stats-grid stats-v21" id="statsGrid" role="region" aria-label="核心数据统计">
    <div class="stat-card" title="catalog.csv 中的人工精选行数"><div class="stat-num c1" id="statCurated" data-target={catalogItems.length}>{catalogItems.length}</div><div class="stat-label">精选工具</div></div>
    <div class="stat-card" title="Pipeline 自动发现的候选条目"><div class="stat-num c3" id="statCand" data-target="0">…</div><div class="stat-label">发现候选</div></div>
    <div class="stat-card" title="MCP initialize 握手实测通过的端点数"><div class="stat-num c1" id="statVfy">—</div><div class="stat-label">端点实测 OK</div></div>
    <div class="stat-card" title="已收录仓库的 GitHub Stars 累加"><div class="stat-num c4" id="statStars">…</div><div class="stat-label">累计 GitHub Stars</div></div>
  </div>

  <!-- ===== 核心功能入口区：四模块 2×2（排行榜 → 评测 → 地图 → 社区） ===== -->
