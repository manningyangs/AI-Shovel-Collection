<style>
  /* ===== 核心功能入口区：四大引导模块 2×2 网格 ===== */
  .home-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
    max-width: 980px;
    /* 上距统计区 28px（沿用原模块节奏）；下距工具目录 36px，避免第二行卡片贴住筛选栏 */
    margin: 28px auto 36px;
  }
  /* 四个模块根节点各带 margin（28px auto 0 等），且工具地图为行内样式 ——
     统一清零，间距只由网格外层管理，避免叠加 */
  .home-feature-grid > :global(*) { margin: 0 !important; min-width: 0; }
  /* 网格内 Stars 榜单：单行紧凑排行（排名 / 名称 / Stars / 语言）；
     轨道与卡片都必须 minmax(0)/min-width:0，否则 1fr 的 auto 最小值会被 nowrap 内容撑破 */
  .home-feature-grid .ttv21-row { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .home-feature-grid .ttv21-card {
    display: flex; align-items: center; gap: 8px;
    padding: 11px 14px;
    min-width: 0;
  }
  .home-feature-grid .ttv21-name {
    min-width: 0; overflow-wrap: anywhere; /* 允许换行，不做省略号截断 */
  }
  .home-feature-grid .ttv21-meta { margin-top: 0; margin-left: auto; flex: none; }

  @media (max-width: 768px) {
    /* minmax(0,1fr)：单列时也禁止 min-content 撑破轨道（1fr 自带 auto 最小值会溢出） */
    .home-feature-grid { grid-template-columns: minmax(0, 1fr); margin-bottom: 32px; }
  }

  /* 🤝 社区新提交引导模块（indigo 识别色，视觉语言对齐排行榜/评测报告/工具地图） */
  .community-feat {
    max-width: 980px;
    margin: 28px auto 0;
    padding: 20px 24px;
    background: #f5f3ff;
    border: 1px solid #ddd6fe;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: left;
  }
  .cf-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .cf-head-text { display: flex; flex-direction: column; gap: 6px; }
  .cf-title { font-size: 1.05rem; font-weight: 800; color: #4338ca; letter-spacing: .3px; }
  .cf-sub { font-size: .84rem; color: var(--text-2); line-height: 1.6; }
  .cf-all {
    font-size: .82rem; font-weight: 700; color: var(--primary);
    text-decoration: none; white-space: nowrap; padding-top: 4px;
  }
  .cf-all:hover { text-decoration: underline; }

  .cf-stats {
    display: flex; align-items: center; gap: 10px;
    flex-wrap: wrap; margin-bottom: 14px;
  }
  .cf-stat {
    font-size: .78rem; font-weight: 600; color: #4338ca;
    background: #fff; border: 1px solid #ddd6fe;
    border-radius: 999px; padding: 4px 12px;
  }
  .cf-stat b { font-size: .95rem; font-weight: 800; margin-right: 3px; }
  .cf-stat.warn { color: #b45309; border-color: #fde68a; background: #fffbeb; }
  .cf-stat.ok { color: #166534; border-color: #bbf7d0; background: #f0fdf4; }
  .cf-note { font-size: .74rem; color: var(--text-3); }

  .cf-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }
  .cf-card {
    display: flex; flex-direction: column; gap: 5px;
    background: #fff; border: 1px solid #e9e5fd; border-radius: 10px;
    padding: 12px 14px; text-decoration: none; color: inherit;
    transition: border-color .15s, box-shadow .15s, transform .15s;
  }
  .cf-card:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 10px rgba(79,70,229,.1);
    transform: translateY(-1px);
  }
  .cf-name {
    font-size: .84rem; font-weight: 700; color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    overflow-wrap: anywhere; /* 工具名正常换行，不截断（简介仍按需截断） */
  }
  .cf-desc {
    font-size: .75rem; color: var(--text-2); line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cf-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 2px; }
  .cf-status { font-size: .68rem; font-weight: 700; border-radius: 999px; padding: 2px 8px; }
  .cf-status.pending { background: #fff7ed; color: #9a3412; }
  .cf-status.ok { background: #dcfce7; color: #166534; }
  .cf-src {
    font-size: .68rem; font-weight: 700; background: #eef2ff;
    color: #4338ca; border-radius: 999px; padding: 2px 8px;
  }
  .cf-stars { font-size: .7rem; color: #b45309; font-weight: 600; }

  .cf-empty {
    font-size: .84rem; color: var(--text-2);
    background: #fff; border: 1px dashed #c7d2fe; border-radius: 10px;
    padding: 18px; text-align: center; margin-bottom: 14px;
  }
  .cf-empty a { color: var(--primary); font-weight: 700; text-decoration: none; }
  .cf-empty a:hover { text-decoration: underline; }

  .cf-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .cf-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 18px; border-radius: 8px;
    font-size: .84rem; font-weight: 700; text-decoration: none;
    background: #fff; color: #4338ca; border: 1.5px solid #c7d2fe;
    transition: all .15s;
  }
  .cf-btn:hover { border-color: var(--primary); background: #eef2ff; }
  .cf-btn.primary { background: var(--primary); color: #fff; border-color: var(--primary); }
  .cf-btn.primary:hover { background: #1d4ed8; border-color: #1d4ed8; }

  @media (max-width: 640px) {
    .community-feat { padding: 16px; }
    .cf-head { flex-direction: column; }
    .cf-note { width: 100%; }
  }
</style>

<script is:inline set:html={appJs}></script>
</Base>
