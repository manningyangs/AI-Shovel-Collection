---
import Base from "../layouts/Base.astro";

const base = "/AI-Shovel-Collection";
const evalApiBase = (import.meta.env.PUBLIC_EVAL_API_BASE || "").replace(/\/+$/, "");
---

<Base
  title="📥 提交收录 · AI Shovel Collection"
  description="推荐一个 GitHub 工具仓库，AI Shovel 会自动校验并加入待人工审核候选池；查看社区提交收录列表与处理状态"
  canonical="/submit/"
>

<!-- is:global：列表卡片/进度卡/通知等由页内脚本动态注入，
     无法携带 Astro scoped 属性，必须用全局选择器才能命中 -->
<style is:global>
  :root {
    --primary: #4f46e5;
    --primary-h: #4338ca;
    --text: #0f172a;
    --text-2: #475569;
    --text-3: #94a3b8;
    --border: #e2e8f0;
    --surface: #ffffff;
    --bg: #f8fafc;
    --green: #10b981;
    --red: #dc2626;
    --amber: #d97706;
    --blue: #3b82f6;
  }
  .submit-wrap { max-width: 760px; margin: 0 auto; padding: 40px 20px; }
  .back-home {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; margin-bottom: 16px;
    background: #fff; color: var(--text-2); text-decoration: none;
    border: 1.5px solid var(--border); border-radius: 8px;
    font-size: 13.5px; font-weight: 600; transition: all .15s;
  }
  .back-home:hover { border-color: var(--primary); color: var(--primary); }

  /* 登录状态行（与评测页共用 GitHub OAuth Session） */
  .auth-row {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-bottom: 16px; font-size: 13.5px;
  }
  .auth-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 600;
  }
  .auth-badge.ok  { background: #d1fae5; color: #065f46; }
  .auth-badge.no  { background: #f1f5f9; color: #475569; }
  .auth-badge.err { background: #fee2e2; color: #991b1b; }
  .auth-btn {
    margin: 0 !important; padding: 7px 16px !important; border-radius: 8px !important;
    font-size: 13px !important; font-weight: 600; cursor: pointer;
    background: #24292f !important; color: #fff !important; border: none;
  }
  .auth-btn.ghost {
    background: transparent !important; color: #64748b !important;
    border: 1.5px solid var(--border) !important;
  }
  .auth-btn.ghost:hover:not(:disabled) { border-color: var(--primary); color: var(--primary) !important; }
  .auth-user { color: var(--text-2); font-weight: 600; }
  .submit-hero {
    border-radius: 16px; padding: 32px; margin-bottom: 24px;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%);
    color: #fff; box-shadow: 0 4px 20px rgba(99,102,241,0.25);
  }
  .submit-hero h1 { font-size: 1.65rem; margin: 0 0 10px; }
  .submit-hero p { margin: 0; opacity: 0.92; line-height: 1.7; font-size: 14.5px; }

  /* 视图切换：收录列表 / 提交表单（页面始终停留在 /submit/） */
  .view-switch { display: flex; gap: 10px; margin-bottom: 18px; }
  .view-tab {
    flex: 1; background: #fff; color: var(--text-2);
    border: 1.5px solid var(--border); border-radius: 10px;
    padding: 11px 14px; font-size: 14px; font-weight: 600; cursor: pointer;
    transition: all .15s; font-family: inherit;
  }
  .view-tab:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); background: #fff; }
  .view-tab.active {
    background: var(--primary); color: #fff; border-color: var(--primary);
  }
  .view-tab.active:hover { background: var(--primary-h); color: #fff; }
  .view-tab .tab-mini {
    display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 999px;
    background: #eef2ff; color: var(--primary); font-size: 11.5px; font-weight: 700;
  }
  .view-tab.active .tab-mini { background: rgba(255,255,255,.25); color: #fff; }

  .card {
    background: #fff; border: 1px solid var(--border); border-radius: 12px;
    padding: 22px 24px; margin-bottom: 18px;
  }
  .card h3 { font-size: 14.5px; font-weight: 700; margin: 0 0 14px; color: var(--text); }
  label { display: block; font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }

  input[type="url"], textarea {
    width: 100%; padding: 11px 13px; border: 1.5px solid var(--border);
    border-radius: 8px; font-size: 14px; font-family: inherit; color: var(--text);
    background: #fff; transition: border-color .15s; box-sizing: border-box;
  }
  textarea { resize: vertical; min-height: 100px; font-family: inherit; line-height: 1.6; }
  input:focus, textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.12); }

  button {
    background: var(--primary); color: #fff; border: 0; border-radius: 8px;
    padding: 11px 24px; font-size: 14px; font-weight: 600; cursor: pointer;
    font-family: inherit; transition: background .15s;
  }
  button:hover:not(:disabled) { background: var(--primary-h); }
  button.secondary { background: #fff; color: var(--text); border: 1.5px solid var(--border); }
  button.secondary:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); background: #fff; }
  button:disabled { opacity: .55; cursor: not-allowed; }

  .hint { font-size: 12.5px; color: var(--text-3); margin-top: 6px; line-height: 1.5; }
  .mt { margin-top: 14px; }
  .spinner {
    display: inline-block; width: 14px; height: 14px; border: 2px solid #e2e8f0;
    border-top-color: #fff; border-radius: 50%;
    animation: spin .7s linear infinite; vertical-align: middle; margin-right: 6px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* 结果面板 */
  .result-card { border-radius: 12px; padding: 22px 24px; margin-bottom: 18px; border: 1px solid transparent; }
  .result-success { background: #f0fdf4; border-color: #bbf7d0; }
  .result-error   { background: #fef2f2; border-color: #fecaca; }
  .result-duplicate { background: #fff7ed; border-color: #fed7aa; }
  .result-processing { background: #eff6ff; border-color: #bfdbfe; }

  .result-title { font-weight: 700; font-size: 15px; margin-bottom: 6px; }
  .result-sub { font-size: 13.5px; color: var(--text-2); line-height: 1.6; }

  .submission-id {
    display: inline-block; background: #eef2ff; color: var(--primary);
    padding: 4px 10px; border-radius: 6px; font-family: ui-monospace, Consolas, monospace;
    font-size: 12.5px; font-weight: 600; letter-spacing: .3px;
  }

  .status-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 600;
    white-space: nowrap;
  }
  .pill-queued     { background: #f1f5f9; color: #475569; }
  .pill-processing { background: #dbeafe; color: #1e40af; }
  .pill-candidate  { background: #dcfce7; color: #166534; }
  .pill-duplicate  { background: #ffedd5; color: #9a3412; }
  .pill-rejected   { background: #fee2e2; color: #991b1b; }
  .pill-failed     { background: #f1f5f9; color: #475569; }
  .pill-approved   { background: #dcfce7; color: #14532d; }

  .link-row { margin-top: 14px; font-size: 13px; color: var(--text-2); }
  .link-row a { color: var(--primary); text-decoration: none; }
  .link-row a:hover { text-decoration: underline; }

  /* 额度倒计时（借鉴评测页；使用提交收录后端自己的额度响应） */
  .quota-block {
    margin-top: 14px; padding: 14px 16px; border-radius: 10px;
    background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412;
  }
  .quota-title { font-weight: 700; color: #9a3412; font-size: 0.9rem; }
  .quota-sub { font-size: 0.78rem; color: #c2410c; margin-top: 4px; line-height: 1.5; }
  .quota-row { font-size: 0.85rem; color: #7c2d12; margin-top: 10px; font-weight: 600; }
  .quota-time {
    display: inline-block; font-family: ui-monospace, Consolas, monospace;
    font-size: 1rem; font-weight: 700; color: #9a3412; letter-spacing: 1px;
    background: #ffedd5; padding: 2px 8px; border-radius: 6px; margin-left: 4px;
  }
  .quota-done { margin-top: 10px; font-size: 0.8rem; color: #166534; font-weight: 600; }

  /* 列表视图 */
  .list-head {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 12px; flex-wrap: wrap; margin-bottom: 4px;
  }
  .list-head h3 { margin-bottom: 4px; }
  .list-head-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .pool-cap {
    font-size: 12px; font-weight: 600; color: var(--primary);
    background: #eef2ff; padding: 4px 10px; border-radius: 999px;
  }

  .lgrid { display: grid; gap: 12px; }
  .lcard {
    background: #fff; border: 1px solid var(--border); border-radius: 12px;
    padding: 16px 18px; transition: border-color .15s, box-shadow .15s;
  }
  .lcard:hover { border-color: var(--primary); box-shadow: 0 2px 10px rgba(79,70,229,0.08); }
  .lcard-track { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.12); }
  .lcard-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .lcard-title {
    font-weight: 700; font-size: 14.5px; color: var(--text); text-decoration: none;
    font-family: ui-monospace, Consolas, monospace; word-break: break-all;
  }
  .lcard-title:hover { color: var(--primary); }
  .lcard-desc { font-size: 13px; color: var(--text-2); margin-top: 7px; line-height: 1.55; }
  .lcard-sub { font-size: 12.5px; color: var(--text-3); margin-top: 6px; line-height: 1.5; }
  .lcard-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; align-items: center; }
  .lmeta {
    font-size: 12px; background: #f1f5f9; color: #475569;
    padding: 2px 8px; border-radius: 6px; font-weight: 500;
  }
  .lmeta.stars { background: #fffbeb; color: #b45309; }
  .src-badge {
    font-size: 11.5px; background: #eef2ff; color: #4338ca;
    padding: 2px 9px; border-radius: 999px; font-weight: 700;
  }
  .lcard-foot {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 12px; gap: 8px; flex-wrap: wrap;
  }
  .lcard-foot a.ext { color: var(--primary); font-size: 12.5px; text-decoration: none; font-weight: 600; }
  .lcard-foot a.ext:hover { text-decoration: underline; }

  .list-state {
    text-align: center; padding: 32px 18px; color: var(--text-3);
    background: #f8fafc; border: 1px dashed var(--border); border-radius: 12px;
    font-size: 13.5px; line-height: 1.7;
  }
  .list-state.error { background: #fef2f2; border-color: #fecaca; color: #991b1b; }

  .rules {
    background: #f8fafc; border-radius: 10px; padding: 14px 18px;
    font-size: 13px; color: var(--text-2); line-height: 1.7;
  }
  .rules b { color: var(--text); }
  .rules ul { margin: 8px 0 0; padding-left: 18px; }
  .rules li { margin-bottom: 3px; }

  .api-off {
    background: #fef3c7; border: 1px solid #fde68a; color: #92400e;
    border-radius: 10px; padding: 14px 18px; font-size: 13px; font-weight: 500;
    margin-bottom: 20px;
  }

  footer { text-align: center; color: var(--text-3); font-size: 12.5px; margin-top: 30px; }
</style>

<div class="submit-wrap">
  <a class="back-home" href={`${base}/`}>← 返回主页</a>

  <div class="submit-hero">
    <h1>📥 社区提交收录</h1>
    <p>
      提交一个 GitHub 工具仓库，AI Shovel 会自动完成基础校验；
      校验通过后进入<b>待人工审核候选池</b>，<b>人工审核通过后才会进入精选工具目录</b>。
      <br>你也可以在下方浏览社区提交的全部工具及其处理状态。
    </p>
  </div>

  <div class="auth-row" id="authRow">
    <span class="auth-badge no" id="authBadge">⏳ 正在检查登录状态…</span>
    <span class="auth-user" id="authUser" hidden></span>
    <button class="auth-btn" id="loginBtn" type="button" hidden>🐙 使用 GitHub 登录</button>
    <button class="auth-btn ghost" id="logoutBtn" type="button" hidden>退出登录</button>
  </div>

  <div id="apiOff" class="api-off" style="display:none">
    ⚠️ 后端服务暂未接入（PUBLIC_EVAL_API_BASE 未配置），提交功能暂时不可用。
    请稍后再来，或联系维护者。
  </div>

  <!-- 视图切换：收录列表（默认） / 提交表单 -->
  <div class="view-switch" role="tablist" aria-label="提交收录视图切换">
    <button class="view-tab active" id="tabListView" data-view="list" type="button" role="tab" aria-selected="true">
      📄 收录列表
    </button>
    <button class="view-tab" id="tabFormView" data-view="form" type="button" role="tab" aria-selected="false">
      📝 提交新工具
    </button>
  </div>

  <!-- ========== 视图一：社区提交收录列表 ========== -->
  <div id="viewList">
    <div class="card">
      <div class="list-head">
        <div>
          <h3 style="margin-bottom:4px">📄 社区提交收录列表</h3>
          <div class="hint" id="listMeta" style="margin-top:0">正在加载…</div>
        </div>
        <div class="list-head-actions">
          <span class="pool-cap" id="poolCap" hidden></span>
          <button class="secondary" id="refreshBtn" type="button" style="padding:7px 14px;font-size:13px">⟳ 刷新</button>
        </div>
      </div>
    </div>

    <!-- 结果反馈区（提交成功 / 终态反馈插入到列表视图顶部） -->
    <div id="listNotice"></div>

    <div class="lgrid" id="listGrid"></div>
    <div class="list-state" id="listLoading">正在加载社区提交列表…</div>
    <div class="list-state" id="listEmpty" style="display:none">
      暂无社区提交记录。<br>成为第一个推荐工具的人 →
      <button class="secondary" id="emptyCtaBtn" type="button" style="margin-top:10px">📝 提交新工具</button>
    </div>
    <div class="list-state error" id="listError" style="display:none">
      列表加载失败，请稍后重试。<br>
      <button class="secondary" id="retryBtn" type="button" style="margin-top:10px">⟳ 重新加载</button>
    </div>
  </div>

  <!-- ========== 视图二：提交表单 ========== -->
  <div id="viewForm" style="display:none">
    <!-- 本浏览器之前的提交记录（本地恢复入口，与公开列表是两回事） -->
    <div id="restoreCard" class="card" style="display:none">
      <h3>🔄 恢复之前的提交</h3>
      <p class="hint" id="restoreInfo" style="color:var(--text-2)"></p>
      <div style="display:flex; gap:10px; margin-top:10px">
        <button class="secondary" id="restoreBtn">恢复查询</button>
        <button class="secondary" id="clearBtn">清除记录</button>
      </div>
    </div>

    <!-- 结果反馈区 -->
    <div id="formNotice"></div>

    <!-- 提交表单 -->
    <div class="card" id="formCard">
      <h3>① 填写仓库信息</h3>
      <label for="repoUrl">GitHub 仓库地址 <span style="color:#dc2626">*</span></label>
      <input type="url" id="repoUrl" placeholder="https://github.com/用户名/仓库名"
        autocomplete="off" spellcheck="false">
      <p class="hint">
        示例：<code>https://github.com/PlaywrightMCP/playwright-mcp</code>
        &nbsp;·&nbsp;
        仅支持公开的 GitHub 仓库（Issue / PR / Gist 链接无效）
      </p>

      <label for="reason" class="mt">推荐理由（选填）</label>
      <textarea id="reason" placeholder="为什么觉得这个工具值得推荐？有什么亮点？（最多 500 字）"
        maxlength="500"></textarea>
      <p class="hint"><span id="reasonCount">0</span> / 500 字</p>

      <button id="submitBtn" class="mt" type="button">🚀 提交收录</button>
      <p class="hint" id="submitAuthHint" style="display:none;color:#d97706">
        ⚠️ 提交收录需要先登录 GitHub（与评测页同一账号），请点击上方登录按钮。
      </p>

      <!-- 额度倒计时（服务端 429 响应驱动；刷新页面可恢复） -->
      <div class="quota-block" id="quotaBlock" hidden>
        <div class="quota-title">⚠️ 提交额度已用完</div>
        <div class="quota-sub" id="quotaSub">过去 24 小时内的提交额度已用完，额度按滚动窗口依次释放。</div>
        <div class="quota-row">距离下一次额度释放还有：<span class="quota-time" id="quotaTime">--:--:--</span></div>
        <div class="quota-done" id="quotaDone" hidden>✅ 额度预计已释放，可以重新提交（最终以后端校验为准）。</div>
      </div>
    </div>

    <!-- 规则说明 -->
    <div class="card">
      <h3>📋 收录规则</h3>
      <div class="rules">
        <b>自动校验会检查：</b>
        <ul>
          <li>仓库是否公开可访问</li>
          <li>是否已经在精选目录或候选池中（去重）</li>
          <li>是否已经有同样的仓库正在处理中</li>
          <li>社区候选池是否已满（上限 500 个工具）</li>
        </ul>
        <br>
        <b>候选池不会做的事：</b>
        <ul>
          <li>不会自动信任你的分类判断</li>
          <li>不会自动执行目标仓库代码（安全红线）</li>
          <li>不会直接写入精选目录 <code>catalog.csv</code></li>
        </ul>
        <br>
        审核通过与否，由维护者人工判断项目用途、文档完整度、维护状态、许可证和安全风险。
        <br>
        <b>提交次数限制</b>（个人额度，每 24 小时滚动窗口）与<b>社区候选池容量</b>（500 条）是两个独立限制。
      </div>
    </div>
  </div>

  <footer>
    提交全程在本站完成 · GitHub Token 不暴露给浏览器 ·
    <a href="https://github.com/manningyangs/AI-Shovel-Collection" target="_blank" rel="noopener">AI-Shovel-Collection ↗</a>
  </footer>
</div>

<script is:inline define:vars={{ evalApiBase, base }}>
(function () {
  "use strict";

  // ===== 配置 =====
  const API_BASE = (evalApiBase || "").replace(/\/+$/, "");
  const SESSION_KEY = "EV_SESSION";     // 与评测页共用（同标签页 sessionStorage，仅走 Authorization 头）
  const LS_KEY = "AI_SHOVEL_SUBMISSIONS";     // localStorage 提交记录（本机恢复查询用）
  const QUOTA_KEY = "CS_QUOTA_NEXT_AT";       // 提交额度倒计时（sessionStorage，刷新恢复用）
  const POLL_INTERVALS = [5000, 8000, 12000, 15000]; // 递增轮询间隔
  const TERMINAL = new Set(["candidate_added", "duplicate", "rejected", "failed"]);
  const POOL_CAPACITY = 500; // 社区候选池容量上限（统计口径以后端/工作流为准，此处仅展示）

  // ===== 状态 → 文案映射（严格映射现有后端状态机，不新增状态） =====
  const STATUS_TEXT = {
    queued:       { label: "已收到 · 等待校验",        className: "pill-queued" },
    dispatching:  { label: "已进入校验队列",            className: "pill-queued" },
    processing:   { label: "正在校验",                  className: "pill-processing" },
    candidate_added: { label: "校验通过 · 待人工审核",  className: "pill-candidate" },
    duplicate:    { label: "重复收录",                  className: "pill-duplicate" },
    rejected:     { label: "未通过收录",                className: "pill-rejected" },
    failed:       { label: "系统处理失败",              className: "pill-failed" },
  };

  const TERMINAL_FULL_TEXT = {
    candidate_added: `🎉 自动校验通过<br><br>
      系统已经收到你的工具推荐，<b>正在等待人工审核</b>。<br><br>
      审核通过后，工具会正式进入精选工具目录。在此之前，它会出现在社区提交收录列表中，标记为"待人工审核"。`,

    duplicate: `⚠️ 该工具已经收录或正在审核中。<br><br>
      你可以在精选目录或社区提交收录列表中找到它。`,

    rejected: `❌ 未通过基础校验。<br><br>
      请检查仓库地址是否正确、仓库是否公开可访问，然后重新提交。`,

    failed: `😵 系统处理失败。<br><br>
      请稍后重试，或联系维护者。`,
  };

  // 拒绝原因 → 面向用户的业务文案（按 failure_code 映射，不展示内部错误码/堆栈）
  function rejectedText(failureCode) {
    if (failureCode === "POOL_CAPACITY_REACHED") {
      return `❌ 社区候选池已满（${POOL_CAPACITY} 条）。<br><br>
        本次提交暂未收录；待有候选转正或移出后可再试。`;
    }
    if (failureCode === "VALIDATION_FAILED") {
      return `❌ 基础校验未通过。<br><br>
        请检查仓库地址是否正确、仓库是否公开可访问，然后重新提交。`;
    }
    return TERMINAL_FULL_TEXT.rejected;
  }

  // ===== 错误反馈：业务错误展示后端业务消息，其余一律友好文案（不暴露内部错误码） =====
  const BUSINESS_CODES = new Set([
    "REPO_URL_REQUIRED", "REPO_URL_TOO_LONG", "REASON_TOO_LONG",
    "INVALID_GITHUB_URL", "IP_DAILY_LIMIT",
  ]);
  const FRIENDLY_MSG = {
    PAYLOAD_TOO_LARGE: "提交内容过大，请减少内容后重试。",
    INVALID_JSON: "系统处理异常，请稍后重试。",
    PARSE_ERROR: "系统处理异常，请稍后重试。",
    WORKFLOW_DISPATCH_FAILED: "自动校验服务暂时不可用，请稍后重试。",
    INTERNAL_ERROR: "系统暂时不可用，请稍后重试。",
    ORIGIN_NOT_ALLOWED: "请求来源异常，请从本站页面重试。",
  };
  function friendlyMessage(err) {
    if (err && BUSINESS_CODES.has(err.code) && err.message) return err.message;
    if (err && FRIENDLY_MSG[err.code]) return FRIENDLY_MSG[err.code];
    return "系统暂时不可用，请稍后重试。";
  }

  // ===== DOM =====
  const $ = (id) => document.getElementById(id);
  const submitBtn = $("submitBtn");
  const repoUrlInput = $("repoUrl");
  const reasonInput = $("reason");
  const reasonCount = $("reasonCount");
  const apiOff = $("apiOff");
  const restoreCard = $("restoreCard");
  const restoreBtn = $("restoreBtn");
  const clearBtn = $("clearBtn");
  const restoreInfo = $("restoreInfo");
  const authBadge = $("authBadge");
  const authUser = $("authUser");
  const loginBtn = $("loginBtn");
  const logoutBtn = $("logoutBtn");
  const submitAuthHint = $("submitAuthHint");
  const viewList = $("viewList");
  const viewForm = $("viewForm");
  const listGrid = $("listGrid");
  const listMeta = $("listMeta");
  const listLoading = $("listLoading");
  const listEmpty = $("listEmpty");
  const listError = $("listError");
  const poolCap = $("poolCap");
  const formNotice = $("formNotice");
  const listNotice = $("listNotice");
  const quotaBlock = $("quotaBlock");
  const quotaSub = $("quotaSub");
  const quotaTime = $("quotaTime");
  const quotaDone = $("quotaDone");

  // ===== 视图切换（表单 / 列表双状态，始终停留在 /submit/） =====
  let currentView = "list"; // 默认列表：进入页面即可看到提交入口和社区收录列表

  function setView(v) {
    currentView = v;
    viewList.style.display = v === "list" ? "" : "none";
    viewForm.style.display = v === "form" ? "" : "none";
    document.querySelectorAll(".view-tab").forEach((t) => {
      const on = t.getAttribute("data-view") === v;
      t.classList.toggle("active", on);
      t.setAttribute("aria-selected", String(on));
    });
    if (v === "list") refreshList();
  }
  document.querySelectorAll(".view-tab").forEach((t) => {
    t.addEventListener("click", () => setView(t.getAttribute("data-view")));
  });

  // ===== 登录态（强制登录：未登录不可提交；列表公开可浏览） =====
  function token() { return sessionStorage.getItem(SESSION_KEY) || ""; }
  function clearSession() { sessionStorage.removeItem(SESSION_KEY); }

  function setAuthBadge(kind, text) {
    authBadge.className = "auth-badge " + kind;
    authBadge.textContent = text;
  }

  function updateSubmitGate() {
    if (!API_BASE) { submitBtn.disabled = true; return; }   // 服务未接入
    const ok = !!token() && !quotaActive;
    submitBtn.disabled = !ok;
    submitAuthHint.style.display = token() ? "none" : "";
  }

  function showLoginState() {
    setAuthBadge("no", "未登录");
    authUser.hidden = true;
    loginBtn.hidden = false;
    logoutBtn.hidden = true;
    updateSubmitGate();
  }

  function showLoggedIn(user) {
    setAuthBadge("ok", "已登录");
    authUser.hidden = false;
    authUser.textContent = "@" + (user.login || user.name || "user");
    loginBtn.hidden = true;
    logoutBtn.hidden = false;
    updateSubmitGate();
  }

  // ===== API 未配置警告 =====
  if (!API_BASE) {
    apiOff.style.display = "";
    setAuthBadge("err", "提交服务未接入");
    loginBtn.hidden = true;
    logoutBtn.hidden = true;
    submitBtn.disabled = true;
    listLoading.style.display = "none";
    listMeta.textContent = "提交服务未接入，列表暂不可用。";
  }

  // ===== 字数计数 =====
  reasonInput?.addEventListener("input", () => {
    reasonCount.textContent = reasonInput.value.length;
  });

  // ===== 提交按钮 =====
  submitBtn?.addEventListener("click", handleSubmit);
  repoUrlInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      handleSubmit();
    }
  });

  /* ============================================================
   * 额度倒计时（参考评测页；字段来自提交收录后端 429 响应）
   * 格式 HH:MM:SS，每秒刷新；刷新页面可恢复；到期不自动提交。
   * ============================================================ */
  let quotaTimer = null;
  let quotaActive = false;

  function clearQuotaTimer() {
    if (quotaTimer) { clearInterval(quotaTimer); quotaTimer = null; }
  }

  function formatHMS(sec) {
    sec = Math.max(0, Math.floor(sec));
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = sec % 60;
    const pad = (n) => String(n).padStart(2, "0");
    return `${pad(h)}:${pad(m)}:${pad(s)}`;
  }

  function startQuotaCountdown(nextAtIso, used, limit) {
    clearQuotaTimer();
    const nextMs = new Date(nextAtIso).getTime();
    if (!nextMs || isNaN(nextMs)) return;
    // 保存服务端返回的倒计时状态（含已用/上限），页面刷新后恢复
    try {
      sessionStorage.setItem(QUOTA_KEY, JSON.stringify({
        next: nextAtIso,
        used: typeof used === "number" ? used : null,
        limit: typeof limit === "number" ? limit : null,
        receivedAt: Date.now(),
      }));
    } catch (e) { /* storage 不可用时仅本次生效 */ }

    quotaActive = true;
    quotaBlock.hidden = false;
    quotaDone.hidden = true;
    quotaTime.hidden = false;
    if (typeof used === "number" && typeof limit === "number") {
      quotaSub.textContent = `过去 24 小时内已使用 ${used}/${limit} 次提交额度（个人提交额度，按滚动窗口释放）。`;
    }
    quotaTime.textContent = formatHMS((nextMs - Date.now()) / 1000);
    updateSubmitGate();

    quotaTimer = setInterval(() => {
      const remain = Math.floor((nextMs - Date.now()) / 1000);
      if (remain <= 0) {
        clearQuotaTimer();
        quotaActive = false;
        try { sessionStorage.removeItem(QUOTA_KEY); } catch (e) {}
        quotaTime.textContent = "00:00:00";
        quotaTime.hidden = true;
        quotaDone.hidden = false;
        updateSubmitGate(); // 恢复按钮可点；不自动提交，由用户主动点击，最终以后端校验为准
        return;
      }
      quotaTime.textContent = formatHMS(remain);
    }, 1000);
  }

  function restoreQuotaFromStorage() {
    try {
      const raw = sessionStorage.getItem(QUOTA_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      const nextMs = new Date(data && data.next).getTime();
      if (!nextMs || nextMs <= Date.now()) {
        sessionStorage.removeItem(QUOTA_KEY);
        return;
      }
      startQuotaCountdown(data.next, data.used, data.limit);
    } catch (e) { try { sessionStorage.removeItem(QUOTA_KEY); } catch (e2) {} }
  }

  /* ============================================================
   * 社区提交收录列表（后端公开数据源 + 候选池静态数据补充简介/Stars）
   * ============================================================ */
  let listData = [];
  let listSeq = 0;
  let pendingHighlight = null; // 需要高亮定位的提交编号
  const pool = { total: null, byId: {}, bySlug: {} };

  async function fetchPool() {
    if (!API_BASE && !base) return;
    try {
      const r = await fetch(`${base}/submissions/candidates.json?ts=` + Math.floor(Date.now() / 60000));
      if (!r.ok) return;
      const j = await r.json();
      const arr = Array.isArray(j) ? j : (Array.isArray(j.candidates) ? j.candidates : []);
      pool.total = typeof j.total === "number" ? j.total : arr.length;
      arr.forEach((c) => {
        if (c.submission_id) pool.byId[c.submission_id] = c;
        if (c.repo_slug) pool.bySlug[String(c.repo_slug).toLowerCase()] = c;
      });
      if (typeof pool.total === "number") {
        poolCap.textContent = `候选池 ${pool.total} / ${POOL_CAPACITY}`;
        poolCap.hidden = false;
      }
      if (listData.length) renderList();
    } catch (e) { /* 池数据缺失时仅失去简介/Stars 补充 */ }
  }

  async function refreshList() {
    if (!API_BASE) return;
    const seq = ++listSeq;
    try {
      const resp = await fetch(`${API_BASE}/api/collection-submissions`);
      if (!resp.ok) throw new Error("bad status");
      const data = await resp.json();
      if (seq !== listSeq) return; // 已有更新的请求，丢弃旧响应
      listData = Array.isArray(data && data.submissions) ? data.submissions : [];
      listLoading.style.display = "none";
      listError.style.display = "none";
      renderList();
    } catch (e) {
      if (seq !== listSeq) return;
      listLoading.style.display = "none";
      if (!listData.length) listError.style.display = ""; // 已有数据时保留旧列表，不闪烁错误
    }
  }

  function esc(s) {
    return String(s || "").replace(/[<>&"']/g, (c) =>
      ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;", "'": "&#39;" })[c]);
  }

  function fmtStars(n) { return Number(n).toLocaleString(); }

  function fmtTime(iso) {
    try {
      const d = new Date(iso);
      if (isNaN(d.getTime())) return "";
      const pad = (n) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    } catch (e) { return ""; }
  }

  function statusInfo(sub, poolEntry) {
    if (sub.status === "candidate_added") {
      if (poolEntry && poolEntry.review_status === "approved") {
        return { label: "已人工审核", className: "pill-approved" };
      }
      return STATUS_TEXT.candidate_added;
    }
    if (sub.status === "rejected" && sub.failure_code === "POOL_CAPACITY_REACHED") {
      return { label: "候选池已满", className: "pill-duplicate" };
    }
    return STATUS_TEXT[sub.status] || { label: sub.status, className: "pill-queued" };
  }

  function cardSubline(sub, poolEntry) {
    switch (sub.status) {
      case "queued":
      case "dispatching":
        return "已收到提交，自动校验即将开始。";
      case "processing":
        return "正在获取仓库信息并完成基础校验。";
      case "candidate_added":
        if (poolEntry && poolEntry.review_status === "approved") {
          return "人工审核已通过。";
        }
        return "已进入社区候选池，等待人工审核；审核通过后进入精选目录。";
      case "duplicate":
        return "该仓库已在精选目录或社区候选池中，无需重复提交。";
      case "rejected":
        if (sub.failure_code === "POOL_CAPACITY_REACHED") {
          return `社区候选池已达 ${POOL_CAPACITY} 条上限，本次提交未收录。`;
        }
        return "未通过基础校验，请检查仓库地址与仓库可见性后重新提交。";
      case "failed":
        return "系统处理失败，请稍后重试；如多次失败可联系维护者。";
      default:
        return "";
    }
  }

  function renderList() {
    const total = listData.length;
    listMeta.textContent = total ? `共 ${total} 条社区提交记录` : "";
    listEmpty.style.display = total ? "none" : "";
    listGrid.innerHTML = listData.map((sub) => {
      const poolEntry = pool.byId[sub.submission_id] || pool.bySlug[String(sub.repo || "").toLowerCase()] || null;
      const st = statusInfo(sub, poolEntry);
      const desc = poolEntry && poolEntry.description ? String(poolEntry.description).slice(0, 200) : "";
      const stars = poolEntry && typeof poolEntry.stars === "number" ? poolEntry.stars : null;
      const lang = poolEntry && poolEntry.language ? String(poolEntry.language) : "";
      const title = (poolEntry && poolEntry.title) || sub.repo || "";
      const tracked = sub.submission_id === pendingHighlight ||
        (activePoll && sub.submission_id === activePoll.id);
      const timeStr = fmtTime(sub.created_at);
      return `<article class="lcard${tracked ? " lcard-track" : ""}" data-id="${esc(sub.submission_id)}">
        <div class="lcard-top">
          <a class="lcard-title" href="${esc(sub.repo_url)}" target="_blank" rel="noopener">${esc(title)}</a>
          <span class="status-pill ${st.className}">${esc(st.label)}</span>
        </div>
        ${desc ? `<div class="lcard-desc">${esc(desc)}</div>` : ""}
        <div class="lcard-sub">${esc(cardSubline(sub, poolEntry))}</div>
        <div class="lcard-meta">
          ${stars !== null ? `<span class="lmeta stars">⭐ ${fmtStars(stars)}</span>` : ""}
          ${lang ? `<span class="lmeta">${esc(lang)}</span>` : ""}
          ${timeStr ? `<span class="lmeta" title="提交时间">🕒 ${timeStr}</span>` : ""}
          <span class="src-badge">社区提交</span>
        </div>
        <div class="lcard-foot">
          <span class="submission-id">${esc(sub.submission_id)}</span>
          <span>
            <a class="ext" href="${esc(sub.repo_url)}" target="_blank" rel="noopener">GitHub 仓库 ↗</a>
          </span>
        </div>
      </article>`;
    }).join("");
  }

  $("refreshBtn")?.addEventListener("click", () => refreshList());
  $("retryBtn")?.addEventListener("click", () => refreshList());
  $("emptyCtaBtn")?.addEventListener("click", () => setView("form"));

  // ===== 结果卡片（插入到当前视图顶部；不展示内部错误码/堆栈/原始 JSON） =====
  function showResult(kind, htmlContent) {
    document.querySelectorAll(".result-card").forEach((el) => el.remove());
    const card = document.createElement("div");
    card.className = `result-card result-${kind}`;
    card.innerHTML = htmlContent;
    const zone = currentView === "form" ? formNotice : listNotice;
    zone.innerHTML = "";
    zone.appendChild(card);
    card.scrollIntoView({ behavior: "smooth", block: "center" });
    return card;
  }

  let autoReturnTimer = null;
  function scheduleAutoReturn() {
    if (autoReturnTimer) clearTimeout(autoReturnTimer);
    autoReturnTimer = setTimeout(() => {
      if (currentView === "form") setView("list");
    }, 3000);
  }

  function showProgressCard(submissionId, repoSlug, status, title) {
    const pillInfo = STATUS_TEXT[status] || STATUS_TEXT.queued;
    const card = showResult("processing", `
      <div class="result-title">✅ ${title || "提交成功 · 正在校验"}</div>
      <div class="result-sub" style="margin-top:6px">
        仓库：<code>${esc(repoSlug)}</code>
      </div>
      <div class="result-sub" style="margin-top:6px">
        提交编号：<span class="submission-id">${esc(submissionId)}</span>
        &nbsp;&nbsp;
        <span class="status-pill ${pillInfo.className}">${esc(pillInfo.label)}</span>
      </div>
      <div class="link-row" style="margin-top:12px">
        状态查询链接：<a href="?submission=${esc(submissionId)}">?submission=${esc(submissionId)}</a>
        &nbsp;·&nbsp; <button class="secondary" id="copyLinkBtn" style="padding:4px 10px;font-size:12px">📋 复制</button>
      </div>
      <div class="link-row" style="margin-top:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <button class="secondary" id="toListBtn" style="padding:7px 16px;font-size:13px">📄 查看收录列表</button>
        <span class="hint" style="margin-top:0">3 秒后自动返回收录列表，可在列表中看到该提交的实时状态…</span>
      </div>
    `);

    card.querySelector("#copyLinkBtn")?.addEventListener("click", (e) => {
      const btn = e.currentTarget;
      const link = `${location.origin}${location.pathname}?submission=${submissionId}`;
      navigator.clipboard.writeText(link).then(() => {
        btn.textContent = "✓ 已复制";
        setTimeout(() => { btn.textContent = "📋 复制"; }, 1500);
      });
    });
    card.querySelector("#toListBtn")?.addEventListener("click", () => {
      if (autoReturnTimer) { clearTimeout(autoReturnTimer); autoReturnTimer = null; }
      setView("list");
    });

    return card;
  }

  function showTerminalCard(submissionId, repoSlug, status, failureCode) {
    const pillInfo = STATUS_TEXT[status] || STATUS_TEXT.queued;
    const emojiMap = { candidate_added: "🎉", duplicate: "⚠️", rejected: "❌", failed: "😵" };
    const titleMap = {
      candidate_added: "🎉 自动校验通过",
      duplicate: "⚠️ 重复收录",
      rejected: "❌ 未通过收录",
      failed: "😵 系统处理失败",
    };
    const kind = status === "candidate_added" ? "success"
              : status === "duplicate" ? "duplicate"
              : "error";
    const fullText = status === "rejected"
      ? rejectedText(failureCode)
      : (TERMINAL_FULL_TEXT[status] || "处理完成。");

    const card = showResult(kind, `
      <div class="result-title">${emojiMap[status] || "📋"} ${titleMap[status] || "处理完成"}</div>
      <div class="result-sub" style="margin-top:6px">
        仓库：<code>${esc(repoSlug)}</code>
      </div>
      <div class="result-sub" style="margin-top:6px">
        提交编号：<span class="submission-id">${esc(submissionId)}</span>
        &nbsp;&nbsp;
        <span class="status-pill ${pillInfo.className}">${esc(pillInfo.label)}</span>
      </div>
      <div class="result-sub" style="margin-top:10px">${fullText}</div>
      <div class="link-row" style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap">
        <button class="secondary" id="toListBtn" style="padding:7px 16px;font-size:13px">📄 查看收录列表</button>
        <button id="againBtn" style="padding:7px 16px;font-size:13px">📝 继续提交</button>
      </div>
    `);

    card.querySelector("#toListBtn")?.addEventListener("click", () => setView("list"));
    card.querySelector("#againBtn")?.addEventListener("click", () => {
      resetForm();
      setView("form");
      repoUrlInput.focus();
    });

    resetForm();
    return card;
  }

  function showErrorCard(title, message, suggestion) {
    const card = showResult("error", `
      <div class="result-title">❌ ${esc(title)}</div>
      <div class="result-sub" style="margin-top:6px">${esc(message)}</div>
      ${suggestion ? `<div class="result-sub" style="margin-top:10px">${suggestion}</div>` : ""}
    `);
    return card;
  }

  // ===== 提交 =====
  async function handleSubmit() {
    if (!API_BASE) return;

    const repoUrl = (repoUrlInput.value || "").trim();
    const reason = (reasonInput.value || "").trim();

    // 前端校验
    if (!repoUrl) {
      showErrorCard("请填写仓库地址", "GitHub 仓库地址不能为空");
      repoUrlInput.focus();
      return;
    }
    if (reason.length > 500) {
      showErrorCard("推荐理由过长", "最多 500 字");
      reasonInput.focus();
      return;
    }
    if (!/^https?:\/\/(?:www\.)?github\.com\/[^/\s]+\/[^/\s?#]+\/?.*$/i.test(repoUrl)) {
      showErrorCard("GitHub 仓库地址格式不正确", "仅支持 https://github.com/owner/repo 格式的公开仓库地址。Issue / PR / Gist 链接无效。");
      repoUrlInput.focus();
      return;
    }
    // 强制登录：未登录不允许提交
    if (!token()) {
      showLoginState();
      showErrorCard("请先登录", "提交收录需要 GitHub 登录（与评测页同一账号）。", "点击上方的「🐙 使用 GitHub 登录」按钮完成登录后再提交。");
      return;
    }
    // 额度倒计时期间不允许提交（到期后由用户主动点击，最终以后端校验为准）
    if (quotaActive) {
      showErrorCard("提交额度未释放", "当前提交额度已用完，请等待倒计时结束后再提交。");
      return;
    }

    // 禁止重复点击
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner"></span>提交中…';

    try {
      const headers = { "Content-Type": "application/json" };
      const t = token();
      if (t) headers["Authorization"] = "Bearer " + t;
      const resp = await fetch(`${API_BASE}/api/collection-submissions`, {
        method: "POST",
        headers,
        body: JSON.stringify({ repo_url: repoUrl, reason }),
      });

      const data = await resp.json().catch(() => null);
      const err = (data && data.error) || null;

      if (resp.status === 202 && data && data.success && data.submission_id) {
        // 提交成功 —— 反馈后自动返回收录列表，列表中可见该提交的实时状态
        const id = data.submission_id;
        const slug = extractSlug(repoUrl);
        saveSubmission(id, slug);
        pendingHighlight = id;
        resetForm();
        showProgressCard(id, slug, data.status || "dispatching", "提交成功 · 正在校验");
        startPolling(id, slug);
        scheduleAutoReturn();
      } else if (data && data.success && data.submission_id) {
        // 提交已入库但触发校验失败（502）——友好提示，列表中可见失败状态
        saveSubmission(data.submission_id, extractSlug(repoUrl));
        pendingHighlight = data.submission_id;
        showErrorCard("提交失败", "自动校验服务暂时不可用，本次提交未能开始校验，请稍后重试。", "你可以在收录列表中看到该提交记录。");
        scheduleAutoReturn();
      } else if (resp.status === 409 && err && err.code === "DUPLICATE_IN_PROGRESS") {
        // 已有同仓库进行中任务 —— 跟踪已有提交并返回列表
        const existingId = err.submission_id;
        const existingSlug = extractSlug(repoUrl);
        if (existingId) {
          saveSubmission(existingId, existingSlug);
          pendingHighlight = existingId;
          resetForm();
          showProgressCard(existingId, existingSlug, err.status || "processing", "该仓库已有提交在处理中");
          startPolling(existingId, existingSlug);
          scheduleAutoReturn();
        } else {
          showErrorCard("该仓库已在处理中", "该仓库已有提交正在处理中，请稍后在收录列表查看状态。");
        }
      } else if (resp.status === 401) {
        // 登录失效 —— 清 session、回到未登录态
        clearSession();
        showLoginState();
        showErrorCard("登录已过期", "请重新登录 GitHub 后再提交。");
      } else if (resp.status === 429 && err && err.next_available_at) {
        // 提交额度用完 —— 展示实时倒计时（HH:MM:SS），刷新后可恢复
        startQuotaCountdown(err.next_available_at, err.used, err.limit);
        showErrorCard(
          "提交次数已达上限",
          err.message || `过去 24 小时内的提交次数已达上限（${err.used ?? "?"}/${err.limit ?? "?"} 次）。`,
          "额度按 24 小时滚动窗口依次释放，倒计时结束后可继续提交（不会自动提交，请手动点击）。"
        );
      } else if (resp.status === 429) {
        showErrorCard("提交次数已达上限", "过去 24 小时内的提交次数已达上限，请稍后再试。");
      } else {
        showErrorCard(
          "提交失败",
          friendlyMessage(err),
          "如持续出现，请稍后再试或联系维护者。"
        );
      }
    } catch (err) {
      showErrorCard(
        "网络错误",
        "无法连接到服务器，请检查网络连接后重试。",
        "如果问题持续，可能是服务暂时不可用，请稍后再来。"
      );
    } finally {
      submitBtn.innerHTML = "🚀 提交收录";
      updateSubmitGate();   // 按登录态 + 额度状态决定是否可点
    }
  }

  // ===== 轮询（跟踪中的提交；每次轮询同步刷新列表状态） =====
  let pollingTimer = null;
  let pollAttempt = 0;
  let activePoll = null;   // 当前跟踪中的提交 {id, slug}

  function startPolling(id, slug) {
    if (!API_BASE) return;
    stopPolling();
    activePoll = { id, slug };
    pendingHighlight = id;
    pollAttempt = 0;
    doPoll(id, slug);
  }

  function stopPolling() {
    if (pollingTimer) {
      clearTimeout(pollingTimer);
      pollingTimer = null;
    }
  }

  async function doPoll(id, slug) {
    try {
      // 注意：不要加 Cache-Control 等自定义请求头 —— 会触发 CORS 预检，
      // 而 Worker 的 Access-Control-Allow-Headers 只放行 Content-Type / Authorization，
      // 预检失败会让轮询永远拿不到状态（服务端响应本身已带 no-store）。
      const resp = await fetch(`${API_BASE}/api/collection-submissions/${id}`);
      if (!resp.ok) {
        // 404 / 其他错误 —— 不阻塞，继续轮询
        scheduleNextPoll(id, slug);
        return;
      }
      const data = await resp.json().catch(() => null);
      if (!data) { scheduleNextPoll(id, slug); return; }

      const status = data.status;

      if (TERMINAL.has(status)) {
        stopPolling();
        activePoll = null;
        showTerminalCard(id, slug, status, data.failure_code);
        updateLocalStorageRecord(id, status);
        refreshList();   // 让列表立即反映终态
      } else {
        updateProgressCard(status);
        refreshList();   // 列表同步该提交的最新状态
        scheduleNextPoll(id, slug);
      }
    } catch (err) {
      // 网络错误 / CORS 错误 —— 继续轮询（细节仅留控制台，不展示给用户）
      console.warn("[submit] poll failed, will retry:", err?.message || err);
      scheduleNextPoll(id, slug);
    }
  }

  function scheduleNextPoll(id, slug) {
    pollAttempt++;
    const idx = Math.min(pollAttempt, POLL_INTERVALS.length - 1);
    const delay = POLL_INTERVALS[idx];
    pollingTimer = setTimeout(() => doPoll(id, slug), delay);
  }

  function updateProgressCard(status) {
    const card = document.querySelector(".result-card.result-processing");
    if (!card) return;
    const pillInfo = STATUS_TEXT[status] || STATUS_TEXT.queued;
    const pill = card.querySelector(".status-pill");
    if (pill) {
      pill.className = `status-pill ${pillInfo.className}`;
      pill.textContent = pillInfo.label;
    }
  }

  // ===== localStorage（本机提交历史恢复查询；与公开收录列表是两回事） =====
  function loadSubmissions() {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return [];
      const arr = JSON.parse(raw);
      return Array.isArray(arr) ? arr : [];
    } catch { return []; }
  }

  function saveSubmission(id, slug) {
    const list = loadSubmissions();
    const entry = { id, slug, saved_at: Date.now(), status: "queued" };
    // 去重 + 保留最新 3 条
    const filtered = list.filter(s => s.id !== id);
    filtered.unshift(entry);
    localStorage.setItem(LS_KEY, JSON.stringify(filtered.slice(0, 3)));
  }

  function updateLocalStorageRecord(id, status) {
    const list = loadSubmissions();
    const idx = list.findIndex(s => s.id === id);
    if (idx >= 0) {
      list[idx].status = status;
      localStorage.setItem(LS_KEY, JSON.stringify(list));
    }
  }

  function clearLocalStorage() {
    localStorage.removeItem(LS_KEY);
    restoreCard.style.display = "none";
  }

  // ===== URL query ?submission=ID（状态分享链接） =====
  function tryQueryRestore() {
    const url = new URL(location.href);
    const subId = url.searchParams.get("submission");
    if (subId && /^CS-[a-f0-9]{32}$/i.test(subId)) {
      saveSubmission(subId, "unknown/unknown");
      setView("list");
      pendingHighlight = subId;
      startPolling(subId, "unknown/unknown");
      // 清理 URL
      url.searchParams.delete("submission");
      history.replaceState({}, "", url.toString());
      return true;
    }
    return false;
  }

  // ===== 恢复卡片 =====
  function setupRestore() {
    const list = loadSubmissions();
    if (list.length === 0) return;
    const recent = list[0];
    const ageMin = Math.floor((Date.now() - (recent.saved_at || Date.now())) / 60000);
    const ageText = ageMin < 1 ? "刚刚" : ageMin < 60 ? `${ageMin} 分钟前` : `${Math.floor(ageMin/60)} 小时前`;

    restoreInfo.innerHTML = `
      最近有一条本机提交记录：<br>
      编号 <span class="submission-id">${esc(recent.id)}</span>
      ${recent.slug && recent.slug !== "unknown/unknown" ? `· <code>${esc(recent.slug)}</code>` : ""}
      · <b>${ageText}</b>
      ${recent.status && recent.status !== "queued" && STATUS_TEXT[recent.status] ? `· 当前状态：${STATUS_TEXT[recent.status].label}` : ""}
      <br><span class="hint" style="margin-top:4px">恢复查询会切换到收录列表并持续跟踪该提交（本机记录，与公开列表相互独立）。</span>
    `;
    restoreCard.style.display = "";
    restoreBtn?.addEventListener("click", () => {
      setView("list");
      startPolling(recent.id, recent.slug);
      refreshList();
    });
    clearBtn?.addEventListener("click", clearLocalStorage);
  }

  // ===== 工具函数 =====
  function resetForm() {
    repoUrlInput.value = "";
    reasonInput.value = "";
    reasonCount.textContent = "0";
  }

  function extractSlug(url) {
    const m = (url || "").match(/github\.com\/([^/]+\/[^/?#]+)/i);
    return m ? m[1].replace(/\.git$/, "") : "unknown/unknown";
  }

  // ===== 最近提交自动续查（无需手动刷新，切回页面自动恢复跟踪） =====
  function autoResume() {
    const list = loadSubmissions();
    if (!list.length) return false;
    const recent = list[0];
    const ageMs = Date.now() - (recent.saved_at || 0);
    const pending = !recent.status || !TERMINAL.has(recent.status);
    // 24 小时内仍在处理中的提交：加载页面后自动在列表中跟踪并刷新状态
    if (pending && ageMs < 24 * 3600 * 1000) {
      restoreCard.style.display = "none";
      setView("list");
      startPolling(recent.id, recent.slug);
      return true;
    }
    setupRestore(); // 兜底：更早或已终态的记录仍提供手动恢复入口
    return false;
  }

  // ===== 初始化 =====
  function init() {
    // 视图参数：首页「提交新工具」入口 → /submit/?view=form 直达表单
    const params = new URLSearchParams(location.search);
    const wantForm = params.get("view") === "form";
    if (wantForm) {
      setView("form");
      params.delete("view");
      const url = new URL(location.href);
      url.searchParams.delete("view");
      history.replaceState({}, "", url.toString());
    }

    // 登录按钮（与评测页同一条 GitHub OAuth 链路，回跳到本页）
    loginBtn.addEventListener("click", () => {
      sessionStorage.setItem("EV_RETURN", location.href);
      location.href = API_BASE + "/auth/github/start?return_to=" +
        encodeURIComponent(base + "/auth/callback");
    });

    logoutBtn.addEventListener("click", () => {
      const t = token();
      fetch(API_BASE + "/api/auth/logout", {
        method: "POST",
        headers: Object.assign(
          { "Content-Type": "application/json" },
          t ? { "Authorization": "Bearer " + t } : {},
        ),
        body: "{}",
      }).catch(() => {}).finally(() => {
        clearSession();
        showLoginState();
      });
    });

    // 额度倒计时恢复（页面刷新后恢复服务端返回的倒计时状态）
    restoreQuotaFromStorage();

    // 公开列表 + 候选池补充数据（无需登录）
    fetchPool();
    refreshList();

    // 恢复登录态
    if (API_BASE && token()) {
      fetch(API_BASE + "/api/me", {
        headers: { "Authorization": "Bearer " + token() },
      })
        .then((res) => (res.ok ? res.json() : Promise.reject({ status: res.status })))
        .then((data) => {
          const user = (data && (data.user || data)) || {};
          if (!user.login && !user.id) { showLoginState(); return; }
          showLoggedIn(user);
        })
        .catch((err) => {
          if (err && err.status === 401) { clearSession(); showLoginState(); }
          else setAuthBadge("err", "登录状态检查失败");
        });
    } else if (API_BASE) {
      showLoginState();
    }

    // 状态分享链接优先；否则自动续查最近进行中的提交
    if (!wantForm && !tryQueryRestore()) {
      autoResume();
    }
  }
  init();

  // 页面离开暂停轮询；切回标签页自动恢复（借鉴评测页）
  window.addEventListener("beforeunload", stopPolling);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "hidden") {
      stopPolling();
    } else if (activePoll && !pollingTimer) {
      startPolling(activePoll.id, activePoll.slug);
    }
  });
})();
</script>

</Base>
